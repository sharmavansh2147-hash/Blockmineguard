# ==============================================================================
# BlockMineGuard Environment Configuration
# Copy this template to .env for local runtime or deployment.
# WARNING: NEVER commit your real private key or API keys to source control!
# ==============================================================================

# --- Blockchain Network Selection ---
# Options: localhost (Hardhat Chain 31337) | sepolia (Ethereum Sepolia Chain 11155111)
BLOCKCHAIN_NETWORK=localhost

# --- Local Blockchain Configuration (Hardhat Chain 31337) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x162A433068F51e18b7d13932F27e66a3f99E6890
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Ethereum Sepolia Testnet Configuration (Chain 11155111) ---
# Paste your dedicated Alchemy Sepolia HTTPS endpoint below (e.g., https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY):
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SEPOLIA_CHAIN_ID=11155111
ALCHEMY_API_KEY=your_alchemy_api_key_here
DEPLOYER_PRIVATE_KEY=your_funded_sepolia_private_key_here
SEPOLIA_CONTRACT_ADDRESS=

# Optional: Etherscan contract verification API key (from https://etherscan.io)
ETHERSCAN_API_KEY=

# --- Backend Flask Configuration ---
DB_PATH=blockmineguard.db
PORT=5001
FLASK_ENV=development

# --- Frontend React Configuration ---
REACT_APP_API_URL=http://localhost:5001